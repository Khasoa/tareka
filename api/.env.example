DATABASE_URL=postgresql+psycopg://tareka_user:your_password@localhost:5432/tareka

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=

# Insights featured images (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
INSIGHT_IMAGE_MAX_BYTES=5242880

# Next.js on-demand revalidation (Phase 2D receiver)
# Vercel server-only: REVALIDATE_SECRET (same value as NEXT_REVALIDATE_SECRET below)
NEXT_REVALIDATE_URL=https://tareka.directory/api/revalidate
NEXT_REVALIDATE_SECRET=
NEXT_REVALIDATE_TIMEOUT_SECONDS=5
